#ifndef CONFIG_H
#define CONFIG_H

// Copy this file to Config.h and fill it in. Config.h is gitignored; this
// sample is what is committed, so keep the two in step when adding a setting.
//
// WiFi credentials are deliberately NOT here and must never be added. EasyWiFi
// takes them through its captive portal and stores them in NVS on the device.

#include <Arduino.h>

// The captive portal's AP name and the basis of the mDNS hostname. A freshly
// flashed board uses this until someone saves the Settings form, which writes
// the real value to NVS.
static const char *DEVICE_NAME = "glow-lamp";

// ===== GitHub OTA =====
// Releases are pulled from https://github.com/<OTA_GITHUB_REPO>/releases/latest
// and the asset must be named firmware.bin. See scripts/release.sh.
//
// Until that repo exists the check simply logs an HTTP 404 and carries on --
// the lamp keeps running, nothing else changes.
static const char *OTA_GITHUB_REPO = "brennanMKE/GlowLamp";

#endif  // CONFIG_H
